# Copy to .env

# Chat model — any GGUF on Hugging Face works via Ollama's hf.co/ syntax.
# Small (Pi-like tier, ~1–4B, Q4) vs large (GPU tier, 7–14B+). Swap in newer models from the Hub.
CHAT_MODEL=hf.co/bartowski/Llama-3.2-3B-Instruct-GGUF:Q4_K_M

# Embedding model (Hugging Face, runs on CPU inside the app container)
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Knowledge pack source (Hugging Face dataset). "simple" English Wikipedia is small enough for a Pi.
KNOWLEDGE_DATASET=wikimedia/wikipedia
KNOWLEDGE_CONFIG=20231101.simple
KNOWLEDGE_MAX_DOCS=20000

# Retrieval
TOP_K=5

# Optional: push benchmark results / knowledge pack to your Hugging Face account (needs network)
HF_TOKEN=
HF_USERNAME=
